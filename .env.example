# ==============================================================================
# PrintEase Environment Configuration Template (.env.example)
#
# Production Architecture:
# - Frontend: Deployed statically to GitHub Pages (https://vinayd-v10.github.io/PrintEase/)
# - Backend: Deployed to Vercel Serverless (https://YOUR-BACKEND.vercel.app)
#
# IMPORTANT SECURITY RULES:
# - Do NOT commit your actual .env file or real secrets to GitHub.
# - Supply backend secrets (SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_KEY_SECRET, etc.)
#   only in your Vercel Project Settings > Environment Variables panel.
# - Supply VITE_API_BASE_URL in your GitHub Repository Secrets or Actions workflow.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://vinayd-v10.github.io
OWNER_EMAIL=vinay8046d@gmail.com
JWT_SECRET=your_32_character_random_jwt_secret_token

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Database, Authentication & Document Storage)
# ------------------------------------------------------------------------------
# Obtain these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=print-documents

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Obtain these from: Razorpay Dashboard > Settings > API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# ------------------------------------------------------------------------------
# 4. Frontend Client Environment Variable (Used by GitHub Pages Build)
# ------------------------------------------------------------------------------
# Points the static frontend to your live Vercel backend deployment
# Example: https://printease-backend.vercel.app
VITE_API_BASE_URL=https://printedge-1.onrender.com

